Cell["\<\
Here we define all contributions to the  reduced Horndeski Lagrangian.\
\>", "Text",
 CellChangeTimes->{{3.9502669562077293`*^9, 3.950266977357449*^9}, {
  3.957863027460915*^9, 
  3.957863032163039*^9}},ExpressionUUID->"bb15cf37-ed3b-492f-b129-\
b7d0ad76e927"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LT", "=", 
  RowBox[{
   RowBox[{"Sqrt", "[", 
    RowBox[{"-", 
     RowBox[{"Detg", "[", "]"}]}], "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"KK", "[", 
      RowBox[{
       RowBox[{"\[CurlyPhi]", "[", 
        RowBox[{
         RowBox[{"LI", "[", "0", "]"}], ",", 
         RowBox[{"LI", "[", "0", "]"}]}], "]"}], ",", 
       RowBox[{"X", "[", "]"}]}], "]"}], "-", 
     RowBox[{
      RowBox[{"G3", "[", 
       RowBox[{
        RowBox[{"\[CurlyPhi]", "[", 
         RowBox[{
          RowBox[{"LI", "[", "0", "]"}], ",", 
          RowBox[{"LI", "[", "0", "]"}]}], "]"}], ",", 
        RowBox[{"X", "[", "]"}]}], "]"}], " ", 
      RowBox[{"Scalar", "[", 
       RowBox[{
        RowBox[{"CD", "[", "b", "]"}], "@", 
        RowBox[{
