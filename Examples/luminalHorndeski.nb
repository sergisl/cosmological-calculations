Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"COLLECTION", ",", "EXTRACTION", ",", 
    RowBox[{"AND", " ", "VALIDATION"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "canonLap", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"canonLap", "[", "expr_", "]"}], ":=", 
     RowBox[{"expr", "//.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Global`cd", "[", 
           RowBox[{"-", "i_"}], "]"}], "[", 
          RowBox[{
           RowBox[{"Global`cd", "[", "i_", "]"}], "[", "x_", "]"}], "]"}], ":>", 
         RowBox[{
          RowBox[{"Global`cd", "[", 
           RowBox[{"-", "Global`d"}], "]"}], "[", 
          RowBox[{
           RowBox[{"Global`cd", "[", "Global`d", "]"}], "[", "x", "]"}], 
          "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Global`cd", "[", "i_", "]"}], "[", 
          RowBox[{
           RowBox[{"Global`cd", "[", 
            RowBox[{"-", "i_"}], "]"}], "[", "x_", "]"}], "]"}], ":>", 
         RowBox[{
          RowBox[{"Global`cd", "[", 
           RowBox[{"-", "Global`d"}], "]"}], "[", 
          RowBox[{
           RowBox[{"Global`cd", "[", "Global`d", "]"}], "[", "x", "]"}], 
          "]"}]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"$\[CurlyEpsilon]", "=", 
     RowBox[{"Symbol", "[", "\"\<xAct`xPand`\[Epsilon]\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Head", "[", "scalarEOMQuadv2", "]"}], "===", "Total"}], ",", 
      RowBox[{"scalarEOMQuadv2", "=", 
       RowBox[{"scalarEOMQuadv2", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"normalizeForExtraction", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Symbol", "[", "\"\<xAct`xTensor`cd\>\"", "]"}], "->", 
       RowBox[{"Symbol", "[", "\"\<Global`cd\>\"", "]"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"distGradOnce", ",", "distGrad"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"distGradOnce", "[", "expr_", "]"}], ":=", 
     RowBox[{"expr", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Global`cd", "[", "idx_", "]"}], "[", "sum_Plus", "]"}], ":>", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"Global`cd", "[", "idx", "]"}], "/@", 
           RowBox[{"List", "@@", "sum"}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Global`cd", "[", "idx_", "]"}], "[", "prod_Times", "]"}], 
          "/;", 
          RowBox[{
           RowBox[{"Count", "[", 
            RowBox[{
             RowBox[{"List", "@@", "prod"}], ",", 
             RowBox[{"_", "?", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Not", "[", 
                 RowBox[{"FreeQ", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"_", "[", 
                    RowBox[{
                    RowBox[{"xAct`xTensor`LI", "[", "1", "]"}], ",", "_"}], 
                    "]"}]}], "]"}], "]"}], "&"}], ")"}]}]}], "]"}], "==", 
           "1"}]}], ":>", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"factors", "=", 
              RowBox[{"List", "@@", "prod"}]}], ",", "pIdx"}], "}"}], ",", 
           RowBox[{
            RowBox[{"pIdx", "=", 
             RowBox[{"First", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"Position", "[", 
                RowBox[{"factors", ",", 
                 RowBox[{"_", "?", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Not", "[", 
                    RowBox[{"FreeQ", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"_", "[", 
                    RowBox[{
                    RowBox[{"xAct`xTensor`LI", "[", "1", "]"}], ",", "_"}], 
                    "]"}]}], "]"}], "]"}], "&"}], ")"}]}]}], "]"}], "]"}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Times", "@@", 
              RowBox[{"Delete", "[", 
               RowBox[{"factors", ",", "pIdx"}], "]"}]}], "*", 
             RowBox[{
              RowBox[{"Global`cd", "[", "idx", "]"}], "[", 
              RowBox[{"factors", "[", 
               RowBox[{"[", "pIdx", "]"}], "]"}], "]"}]}]}]}], "]"}]}]}], 
       "}"}]}]}], ";"}], "\n", 
