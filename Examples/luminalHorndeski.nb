  RowBox[{"DefManifold", "[", 
   RowBox[{"Md", ",", "dim", ",", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], "}"}]}],
    "]"}], ";"}], "\n", 
